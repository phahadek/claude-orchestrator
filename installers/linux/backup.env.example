# REQUIRED
BACKUP_GPG_PASSPHRASE=            # symmetric-encryption passphrase (set in the off-repo mode-600 copy)
RCLONE_REMOTE=b2:my-bucket/orchestrator-backups   # rclone remote:path (or a local dir remote for dev, e.g. /tmp/backup-remote)

# OPTIONAL (defaults shown)
DB_PATH=./dashboard.db           # prod value (applied via 81d5): /srv/orchestrator/data/dashboard.db
BACKUP_WORK_DIR=/tmp/orchestrator-backup
RCLONE_CONFIG=                   # path to an rclone.conf if not ~/.config/rclone/rclone.conf
RETENTION_DAYS=14
