# Off-box backup config for the orchestrator database (dashboard.db).
#
# Copy this to the off-repo location the backup script reads and lock it down:
#
#   mkdir -p ~/.config/orchestrator-backup
#   cp scripts/backup/backup.env.example ~/.config/orchestrator-backup/backup.env
#   chmod 600 ~/.config/orchestrator-backup/backup.env
#
# NEVER commit the real file — it carries the Backblaze B2 application key.
# This .example (no secrets) is the only backup env file that belongs in git.

# --- What to back up -------------------------------------------------------
# Source database. Defaults to the checkout-owned DB the live backend uses.
DB_PATH=/srv/orchestrator/projects/claude-orchestrator/packages/backend/dashboard.db

# Local staging directory for dumps (pruned to RETENTION_DAYS).
BACKUP_LOCAL_DIR=/srv/orchestrator/backups/orchestrator-db

# Retention window in days, applied to BOTH local and remote copies.
RETENTION_DAYS=14

# --- Where to ship it (Backblaze B2 via rclone) ----------------------------
# rclone remote name + bucket + optional prefix within the bucket.
# REMOTE_DEST becomes  ${B2_REMOTE}:${B2_BUCKET}/${B2_PREFIX}
B2_REMOTE=B2ORCHESTRATOR
B2_BUCKET=orchestrator-db-backups
B2_PREFIX=dashboard-db

# --- B2 credentials (headless rclone via env-var connection string) --------
# These define the B2ORCHESTRATOR remote entirely from env, so no rclone.conf
# is required. The remote-name segment is the UPPERCASED B2_REMOTE above.
# Create a bucket-scoped application key in the B2 console (not the master key).
RCLONE_CONFIG_B2ORCHESTRATOR_TYPE=b2
RCLONE_CONFIG_B2ORCHESTRATOR_ACCOUNT=<b2-application-key-id>
RCLONE_CONFIG_B2ORCHESTRATOR_KEY=<b2-application-key>
